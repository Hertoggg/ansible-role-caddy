# Managed by ansible-role-caddy. Read by systemd through the drop-in's
# EnvironmentFile=, and by `caddy validate --envfile` when this role deploys a
# Caddyfile, so the values below exist in one root-owned file and never reach a
# command line where `ps` would expose them.
#
# Single quotes, because they are the only form both readers agree on: systemd
# resolves escape sequences inside double quotes and Caddy's parser does not
# (it unescapes \" only while consuming a multi-line value), so a double-quoted
# value carrying a backslash or a quote would differ between the two. Preflight
# rejects the characters that survive neither form.
{% for key, value in caddy_systemd_env.items() %}
{{ key }}='{{ value | string }}'
{% endfor %}
